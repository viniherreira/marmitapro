# ---------------------------------------------------------------------------
# MarmitaPRO — variáveis de ambiente
#
# Copie este arquivo para `.env.local` e preencha os valores.
# Nada aqui deve ser versionado com valores reais.
# ---------------------------------------------------------------------------

# --- Clerk (autenticação) ---------------------------------------------------
# Painel: https://dashboard.clerk.com → sua aplicação → API keys
# A chave publicável vai para o navegador; a secreta, nunca.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_troque_por_sua_chave
CLERK_SECRET_KEY=sk_test_troque_por_sua_chave

# Mantenha desligado o "modo keyless": sem isso, rodar em desenvolvimento sem
# chaves faz o Clerk provisionar uma instância temporária e gravar chaves no
# .env sozinho, deixando o app meio-configurado (Clerk ativo, Supabase não).
CLERK_ENABLE_KEYLESS=false

# Rotas de autenticação do app. Mantenha como estão, a menos que
# renomeie as pastas em app/(auth).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Supabase (banco de dados) ----------------------------------------------
# Painel: https://supabase.com/dashboard → seu projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=troque_pela_anon_key

# Usada apenas no servidor (Server Components e Server Actions).
# Ignora RLS por definição — nunca exponha esta chave no cliente.
SUPABASE_SERVICE_ROLE_KEY=troque_pela_service_role_key

# --- Aplicação --------------------------------------------------------------
# URL pública, usada em metadados e Open Graph.
# Em produção, algo como https://marmitapro.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Comunidade -------------------------------------------------------------
# Convite do grupo de WhatsApp, no formato https://chat.whatsapp.com/<codigo>.
# Vazio ou fora desse formato, a aba Comunidade avisa que o convite ainda nao
# foi publicado em vez de mandar o usuario para um link quebrado.
# Na hospedagem, cadastre como variavel comum (nao marque Secret): ela precisa
# estar disponivel na compilacao, como toda NEXT_PUBLIC_.
NEXT_PUBLIC_WHATSAPP_COMUNIDADE=

# --- Asaas (cobranca) -------------------------------------------------------
# Painel: https://www.asaas.com -> Integracoes -> Chave de API.
# Sandbox e producao sao contas separadas, com chaves proprias: a de sandbox
# comeca com $aact_hmlg_ e a de producao com $aact_prod_. O app deduz o
# ambiente pelo prefixo, entao trocar esta chave ja troca de ambiente.
# Sem esta variavel, o checkout aparece desligado e nada e bloqueado.
ASAAS_API_KEY=

# Token do webhook, definido ao cadastrar https://SEU-DOMINIO/api/webhooks/asaas
# no painel do Asaas. Ele chega no header asaas-access-token de cada aviso e
# precisa bater exatamente. Nao use a chave de API aqui.
ASAAS_WEBHOOK_TOKEN=

# Opcional: forca o ambiente ("sandbox" ou "producao") quando o prefixo da
# chave nao for suficiente. Em uso normal, deixe vazio.
ASAAS_AMBIENTE=

# --- Rotinas agendadas -------------------------------------------------------
# Senha que a Vercel envia (Authorization: Bearer ...) ao chamar a rotina diaria
# de cobranca em /api/cron/inadimplencia. Sem ela, a rotina se recusa a rodar.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
